{
  "name": "claude-code-gateway",
  "version": "0.1.0",
  "description": "A gateway bridge connecting Claude Code CLI to messaging platforms (Feishu/Lark, WeCom, etc.) with approval control, session management, and rollback support.",
  "main": "src/plugin/index.js",
  "scripts": {
    "start": "node src/plugin/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/ test/"
  },
  "keywords": [
    "claude-code",
    "feishu",
    "lark",
    "wecom",
    "approval",
    "gateway",
    "bridge",
    "openclaw"
  ],
  "author": "jinlio",
  "license": "MIT",
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "minimatch": "^9.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "openclaw": {
    "extensions": ["./src/plugin/index.js"],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    }
  }
}
